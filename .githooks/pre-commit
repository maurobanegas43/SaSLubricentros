#!/bin/bash
# Pre-commit hook to prevent password logging and exposure

set -e

echo "Running security checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

ERRORS=0

# Check for password logging in Go files
echo "Checking Go files for password logging..."
GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -n "$GO_FILES" ]; then
    # Check for log statements with password
    if echo "$GO_FILES" | xargs grep -n 'log\..*[Pp]assword\|logger\..*[Pp]assword\|fmt\.Print.*[Pp]assword' 2>/dev/null; then
        echo -e "${RED}ERROR: Potential password logging detected in Go files${NC}"
        echo "Passwords should never be logged. Use [REDACTED] or remove the log statement."
        ERRORS=$((ERRORS + 1))
    fi
    
    # Check for password in response structs (should use password_hash internally only)
    if echo "$GO_FILES" | xargs grep -n 'json:"password"' 2>/dev/null; then
        echo -e "${YELLOW}WARNING: Password field in JSON response detected${NC}"
        echo "API responses should never include password fields. Use password_hash internally only."
        echo "If this is intentional (e.g., request struct), ensure it's never logged or returned."
    fi
fi

# Check for password logging in Dart files
echo "Checking Dart files for password logging..."
DART_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.dart$' || true)

if [ -n "$DART_FILES" ]; then
    # Check for print/debugPrint statements with password values (exclude comments)
    # Use -h to suppress filename prefix, then filter out comment lines
    MATCHES=$(echo "$DART_FILES" | xargs grep -hn 'print.*[Pp]assword\|debugPrint.*[Pp]assword' 2>/dev/null | grep -v '^\s*\/\/' || true)
    if [ -n "$MATCHES" ]; then
        # Show file:line context for the user
        echo "$DART_FILES" | xargs grep -n 'print.*[Pp]assword\|debugPrint.*[Pp]assword' 2>/dev/null | grep -v '^\s*\/\/' || true
        echo -e "${RED}ERROR: Potential password logging detected in Dart files${NC}"
        echo "Passwords should never be logged. Use SecureLogger or remove the log statement."
        ERRORS=$((ERRORS + 1))
    fi
fi

# Check for hardcoded passwords or secrets
echo "Checking for hardcoded secrets..."
ALL_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(go|dart|yaml|json|env)$' || true)

if [ -n "$ALL_FILES" ]; then
    # Look for potential hardcoded passwords (basic check)
    if echo "$ALL_FILES" | xargs grep -n 'password.*=.*"[^"]\{8,\}"' 2>/dev/null | grep -v 'password_hash\|DB_PASSWORD\|[REDACTED]\|example\|test'; then
        echo -e "${YELLOW}WARNING: Potential hardcoded password detected${NC}"
        echo "Ensure this is not a real password. Use environment variables for secrets."
    fi
fi

# Summary
if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}✗ Pre-commit checks failed with $ERRORS error(s)${NC}"
    echo "Fix the issues above and try again."
    exit 1
else
    echo -e "${GREEN}✓ Security checks passed${NC}"
    exit 0
fi
