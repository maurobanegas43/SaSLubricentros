# ============================================================
# LUBRICENTROS API — Environment Configuration
# ============================================================
# Environment Variables for RENDER deployment
# Copy values from your Supabase dashboard
# ============================================================

# --- Server ---
PORT=8080
APP_ENV=production

# --- Supabase PostgreSQL ---
# Get these from: Supabase Dashboard > Settings > Database
DB_HOST=db.xxxxxx.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-supabase-password
DB_NAME=postgres
DB_SSLMODE=require

# --- JWT Authentication ---
# IMPORTANT: Must be at least 32 characters
# Generate secure key with: openssl rand -base64 48
JWT_SECRET=your-very-long-secret-key-min-32-chars
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_HOURS=168

# --- CORS ---
# Comma-separated list of allowed origins
# Production: your web domain
# Mobile: capacitor://localhost,http://localhost
ALLOWED_ORIGINS=https://tu-dominio.com,capacitor://localhost,http://localhost

# --- Supabase Storage ---
SUPABASE_URL=https://xxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_STORAGE_BUCKET=img-proyecto-3
