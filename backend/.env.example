# ============================================================
# LUBRICENTROS API — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ============================================================

# --- Server ---
PORT=8080
APP_ENV=development  # development | production

# --- Supabase PostgreSQL ---
DB_HOST=db.<your-project-ref>.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-supabase-password-here
DB_NAME=postgres
DB_SSLMODE=require

# --- JWT ---
# Must be at least 32 characters long.
# Generate with: openssl rand -base64 48
JWT_SECRET=your-secret-key-here-must-be-at-least-32-characters-long
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_HOURS=168

# --- Supabase Storage ---
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_STORAGE_URL=https://<your-project-ref>.supabase.co/storage/v1
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=img-proyecto-3
