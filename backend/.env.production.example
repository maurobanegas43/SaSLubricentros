# ============================================================
# LUBRICENTROS API - Production Environment Variables (Example)
# ============================================================
# Set real values ONLY in Render Dashboard environment variables
# ============================================================

# --- Server ---
PORT=8080
APP_ENV=production

# --- Supabase PostgreSQL ---
DB_HOST=aws-1-us-west-2.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.<tu-project-ref>
DB_PASSWORD=<tu-password-seguro>
DB_NAME=postgres
DB_SSLMODE=require

# --- JWT Authentication ---
JWT_SECRET=<minimo-32-caracteres>
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_HOURS=168

# --- CORS ---
ALLOWED_ORIGINS=https://tu-dominio.com,capacitor://localhost,http://localhost

# --- Supabase Storage ---
SUPABASE_URL=https://<tu-project-ref>.supabase.co
SUPABASE_STORAGE_URL=https://<tu-project-ref>.supabase.co/storage/v1
SUPABASE_ANON_KEY=<tu-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<tu-service-role-key>
SUPABASE_STORAGE_BUCKET=img-proyecto-3
